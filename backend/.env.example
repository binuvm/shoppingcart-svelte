# PlanetScale (MySQL-compatible) connection string.
# Get this from your PlanetScale database dashboard: Connect > Prisma
DATABASE_URL="mysql://user:password@host/database?sslaccept=strict"

# Secret used to sign JWT access tokens. Use a long random string in production.
JWT_SECRET="change-me-to-a-long-random-string"

# Origin allowed to call the API (the Svelte dev server / production frontend URL)
CORS_ORIGIN="http://localhost:5173"

PORT=3000
